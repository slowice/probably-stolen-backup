rue,\"internalValueString\":\"\",\"valueInt\":0,\"valueFloat\":0.0,\"valueLong\":0,\"valueDouble\":0.0,\"valueBool\":false},{\"<identifier>k__BackingField\":\"TUTORIAL_PAGE_TITLE\",\"<identifierName>k__BackingField\":\"TYPE-STRING_TUTORIAL_PAGE_TITLE\",\"valueEnabled\":true,\"internalValueString\":\"导师笔记：展示柜\",\"valueInt\":0,\"valueFloat\":0.0,\"valueLong\":0,\"valueDouble\":0.0,\"valueBool\":false},{\"<identifier>k__BackingField\":\"TUTORIAL_PAGE_BODY\",\"<identifierName>k__BackingField\":\"TYPE-STRING_TUTORIAL_PAGE_BODY\",\"valueEnabled\":true,\"internalValueString\":\" 在卷帘门的左侧是展示柜，这是店铺的关键功能之一。\\n根据你放入其中的物品种类，你每天可以吸引一位想要购买该类物品的顾客。\\n例如，如果你放入许多[食物]物品和一件低价值的[医疗]物品，第二天就会有一位购买食物的顾客造访店铺。\\n存放物品的总价值将影响被吸引顾客的社会阶层。\\n升级展示柜能让你吸引到更多顾客。\\n\\n<b>确保在每天开店前为展示柜补充存货。<\/b>\\n不要将违禁品放在展示柜内，否则你将被逮捕。\",\"valueInt\":0,\"valueFloat\":0.0,\"valueLong\":0,\"valueDouble\":0.0,\"valueBool\":false},{\"<identifier>k__BackingField\":\"TUTORIAL_PAGE_SIGNATURE\",\"<identifierName>k__BackingField\":\"TYPE-STRING_TUTORIAL_PAGE_SIGNATURE\",\"valueEnabled\":true,\"internalValueString\":\"——导师\",\"valueInt\":0,\"valueFloat\":0.0,\"valueLong\":0,\"valueDouble\":0.0,\"valueBool\":false}]},{\"identifier\":\"tutorial_page\",\"unitCount\":1,\"uuid\":26,\"itemShape\":{\"<minX>k__BackingField\":0,\"<minY>k__BackingField\":0,\"<flipped>k__BackingField\":false,\"<orientation>k__BackingField\":0,\"<width>k__BackingField\":2,\"<height>k__BackingField\":2,\"data\":[1,1,1,1],\"outside\":0},\"itemModifiedShape\":{\"<minX>k__BackingField\":6,\"<minY>k__BackingField\":2,\"<flipped>k__BackingField\":false,\"<orientation>k__BackingField\":0,\"<width>k__BackingField\":2,\"<height>k__BackingField\":2,\"data\":[1,1,1,1],\"outside\":0},\"itemType\":\"GameItemElement\",\"name\":\"导师笔记：外观检查\",\"shortDescription\":\"\",\"flavorText\":\"\",\"uniqueId\":54,\"unitBaseValue\":0,\"unitValue\":0,\"lateUnitValue\":0,\"backupUnitValue\":0,\"spriteAtlasPath\":\"Items\/itematlas\",\"spritePath\":\"tutorial_page\",\"itemTypes\":[\"DOCU