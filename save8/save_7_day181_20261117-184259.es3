ernalValueString\":\"\",\"valueInt\":0,\"valueFloat\":0.0,\"valueLong\":0,\"valueDouble\":0.0,\"valueBool\":false},{\"<identifier>k__BackingField\":\"IMPORTANT_TAG\",\"<identifierName>k__BackingField\":\"TYPE-STRING_IMPORTANT_TAG\",\"valueEnabled\":true,\"internalValueString\":\"\",\"valueInt\":0,\"valueFloat\":0.0,\"valueLong\":0,\"valueDouble\":0.0,\"valueBool\":false},{\"<identifier>k__BackingField\":\"TUTORIAL_PAPER_TAG\",\"<identifierName>k__BackingField\":\"TYPE-STRING_TUTORIAL_PAPER_TAG\",\"valueEnabled\":true,\"internalValueString\":\"\",\"valueInt\":0,\"valueFloat\":0.0,\"valueLong\":0,\"valueDouble\":0.0,\"valueBool\":false},{\"<identifier>k__BackingField\":\"IS_OWNED_TAG\",\"<identifierName>k__BackingField\":\"TYPE-STRING_IS_OWNED_TAG\",\"valueEnabled\":true,\"internalValueString\":\"\",\"valueInt\":0,\"valueFloat\":0.0,\"valueLong\":0,\"valueDouble\":0.0,\"valueBool\":false},{\"<identifier>k__BackingField\":\"TUTORIAL_PAGE_TITLE\",\"<identifierName>k__BackingField\":\"TYPE-STRING_TUTORIAL_PAGE_TITLE\",\"valueEnabled\":true,\"internalValueString\":\"导师笔记：违禁品\",\"valueInt\":0,\"valueFloat\":0.0,\"valueLong\":0,\"valueDouble\":0.0,\"valueBool\":false},{\"<identifier>k__BackingField\":\"TUTORIAL_PAGE_BODY\",\"<identifierName>k__BackingField\":\"TYPE-STRING_TUTORIAL_PAGE_BODY\",\"valueEnabled\":true,\"internalValueString\":\" 违禁品包括任何被共和国视为非法的物品。持有或出售违禁品伴随着高风险……以及更高的利润率。\\n违禁品分为4个等级：\\n低级（+35%利润率）：虽然严格来说属于非法，但通常会被治安部无视，除非他们有意针对你。\\n中级（+70%利润率）：如果在盘查中被发现，该物品将被没收。\\n高级（+100%利润率）：如果在盘查中被发现，该物品将被没收，并且你将受到罚款。\\n高危级（+150%利润率）：如果在盘查中被发现，店铺将被永久查封，你也会被立即逮捕。\\n此外，如果发现任何违禁品，你在治安部的声望都会下降。\",\"valueInt\":0,\"valueFloat\":0.0,\"valueLong\":0,\"valueDouble\":0.0,\"valueBool\":false},{\"<identifier>k__BackingField\":\"TUTORIAL_PAGE_SIGNATURE\",\"<identifierName>k__BackingField\":\"TYPE-STRING_TUTORIAL_PAGE_SIGNATURE\",\"valueEnabled\":true,\"internalValueString\":\"——导师\",\"valueInt\":0,\"valueFloat\":0.0,\"valueLong\":0,\"valueDouble\":0.0,\"valueBool\":false}]},{\"identifie